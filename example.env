# Copy this file to .env and adjust values for your repository.

# actions: build locally, commit pending changes if requested, and push main so
# GitHub Actions deploys Pages.
# gh-pages: build and publish directly to the gh-pages branch with mkdocs.
DEPLOY_MODE=actions

# Set to false when the deployment values below are real.
DRY_RUN=true

# The branch that contains the source site.
SOURCE_BRANCH=main

# Git remote to push to. Usually origin after:
# git remote add origin git@github.com:YOUR_USER/YOUR_REPO.git
GIT_REMOTE=origin

# Optional public site URL. Leave blank until you know the final Pages URL.
# Example user/org page: https://YOUR_USER.github.io/
# Example project page: https://YOUR_USER.github.io/YOUR_REPO/
SITE_URL=https://YOUR_USER.github.io/YOUR_REPO/

# Set to true when using DEPLOY_MODE=actions and you want the script to create
# a commit before pushing. Leave false if you prefer to commit manually.
AUTO_COMMIT=false
COMMIT_MESSAGE="Deploy SwingBig.Band site"

# Used only when DEPLOY_MODE=gh-pages.
GH_PAGES_BRANCH=gh-pages
